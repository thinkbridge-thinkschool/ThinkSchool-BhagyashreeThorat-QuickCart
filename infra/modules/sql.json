{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "3156601895565114069"
    }
  },
  "parameters": {
    "serverName": {
      "type": "string",
      "metadata": {
        "description": "Logical SQL Server name (globally unique)."
      }
    },
    "databaseName": {
      "type": "string",
      "metadata": {
        "description": "SQL database name."
      }
    },
    "location": {
      "type": "string",
      "metadata": {
        "description": "Azure region."
      }
    },
    "administratorLogin": {
      "type": "string",
      "metadata": {
        "description": "SQL administrator login."
      }
    },
    "administratorLoginPassword": {
      "type": "securestring",
      "metadata": {
        "description": "SQL administrator password."
      }
    },
    "databaseSkuName": {
      "type": "string",
      "defaultValue": "Basic",
      "metadata": {
        "description": "Database SKU name, e.g. Basic, S0, GP_S_Gen5_1."
      }
    },
    "databaseSkuTier": {
      "type": "string",
      "defaultValue": "Basic",
      "metadata": {
        "description": "Database SKU tier, e.g. Basic, Standard, GeneralPurpose."
      }
    },
    "maxSizeBytes": {
      "type": "int",
      "defaultValue": 2147483648,
      "metadata": {
        "description": "Max database size in bytes."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Resource tags applied to every resource."
      }
    }
  },
  "resources": {
    "sqlServer": {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2023-08-01-preview",
      "name": "[parameters('serverName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "administratorLogin": "[parameters('administratorLogin')]",
        "administratorLoginPassword": "[parameters('administratorLoginPassword')]",
        "version": "12.0",
        "minimalTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled",
        "administrators": {
          "administratorType": "ActiveDirectory",
          "azureADOnlyAuthentication": false,
          "login": "202401100142@msteams.mitaoe.ac.in",
          "sid": "a320b42d-0b41-48da-a175-bd37c5188a2e",
          "tenantId": "7e394fc8-4b86-4cfe-810e-43f86f8bec47"
        }
      }
    },
    "database": {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01-preview",
      "name": "[format('{0}/{1}', parameters('serverName'), parameters('databaseName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "[parameters('databaseSkuName')]",
        "tier": "[parameters('databaseSkuTier')]"
      },
      "properties": {
        "maxSizeBytes": "[parameters('maxSizeBytes')]",
        "zoneRedundant": false
      },
      "dependsOn": [
        "sqlServer"
      ]
    },
    "allowAzureServices": {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2023-08-01-preview",
      "name": "[format('{0}/{1}', parameters('serverName'), 'AllowAllAzureIps')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "sqlServer"
      ]
    }
  },
  "outputs": {
    "serverId": {
      "type": "string",
      "metadata": {
        "description": "SQL Server resource id."
      },
      "value": "[resourceId('Microsoft.Sql/servers', parameters('serverName'))]"
    },
    "fullyQualifiedDomainName": {
      "type": "string",
      "metadata": {
        "description": "Fully qualified server name, e.g. myserver.database.windows.net."
      },
      "value": "[reference('sqlServer').fullyQualifiedDomainName]"
    },
    "connectionString": {
      "type": "securestring",
      "metadata": {
        "description": "ADO.NET connection string for the app."
      },
      "value": "[format('Server=tcp:{0},1433;Initial Catalog={1};Encrypt=True;TrustServerCertificate=False;Authentication=Active Directory Default;', reference('sqlServer').fullyQualifiedDomainName, parameters('databaseName'))]"
    }
  }
}